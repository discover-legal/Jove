{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legaleyes.local/schemas/legal_intake.schema.json",
  "x-jurisdiction": "Ontario, Canada",
  "title": "Legal intake",
  "description": "Everything an Ontario law firm captures when opening a matter, taken from scanned client documents: intake forms, letters, contracts, court and tribunal forms, IDs, pay stubs, invoices, ROEs and notices. Keywords: description says what a field holds, examples show typical text, x-not-for says what belongs elsewhere so that sibling fields can be told apart.",
  "type": "object",
  "properties": {
    "client": {
      "type": "object",
      "description": "The firm's own client: the person or organization seeking legal help and paying for it.",
      "properties": {
        "person": {
          "type": "object",
          "description": "The client's identity, when the client is an individual.",
          "properties": {
            "full_name": {
              "type": "string",
              "description": "Client's full legal name.",
              "examples": [
                "Jane Alexandra Doe",
                "DOE, Jane",
                "Tremblay, Marie-Ève"
              ],
              "x-not-for": "Names of anyone else in the matter."
            },
            "other_names": {
              "type": "array",
              "description": "Former, maiden, alias or preferred names.",
              "items": {
                "type": "string",
                "description": "One alternative name.",
                "examples": [
                  "née Smith",
                  "Jen"
                ]
              }
            },
            "date_of_birth": {
              "type": "string",
              "description": "Client's date of birth.",
              "format": "date",
              "examples": [
                "March 12, 2024",
                "2024-03-12",
                "12/03/2024"
              ],
              "x-not-for": "Any other date, e.g. dates of events or documents."
            },
            "gender": {
              "type": "string",
              "description": "Gender or sex, as stated.",
              "examples": [
                "F",
                "M",
                "X"
              ]
            },
            "nationality": {
              "type": "string",
              "description": "Citizenship(s) or nationality.",
              "examples": [
                "Canadian",
                "Canadian and Indian"
              ]
            },
            "occupation": {
              "type": "string",
              "description": "Job or occupation.",
              "examples": [
                "registered nurse",
                "self-employed plumber"
              ],
              "x-not-for": "Details of an employment dispute (those go in employment)."
            },
            "marital_status": {
              "type": "string",
              "description": "Marital or relationship status.",
              "examples": [
                "married",
                "separated",
                "common-law",
                "single"
              ]
            },
            "language": {
              "type": "string",
              "description": "Preferred language, or a need for an interpreter.",
              "examples": [
                "French",
                "needs Punjabi interpreter"
              ]
            }
          }
        },
        "organization": {
          "type": "object",
          "description": "The client's identity, when the client is a corporation, charity or other body.",
          "properties": {
            "legal_name": {
              "type": "string",
              "description": "Registered legal name.",
              "examples": [
                "Acme Widgets Ltd.",
                "1234567 Ontario Inc.",
                "Northside Holdings Corp."
              ]
            },
            "trading_name": {
              "type": "string",
              "description": "Operating or business name, if different.",
              "examples": [
                "Acme Signs",
                "o/a Northside Bakery"
              ]
            },
            "registration_number": {
              "type": "string",
              "description": "Ontario corporation number, federal corporation number, business number (BN) or charity number.",
              "examples": [
                "1234567",
                "Ontario Corporation No. 002345678",
                "BN 123456789RC0001"
              ]
            },
            "jurisdiction_of_incorporation": {
              "type": "string",
              "description": "Where it is incorporated.",
              "examples": [
                "Ontario (OBCA)",
                "Canada (CBCA)"
              ]
            },
            "entity_type": {
              "type": "string",
              "description": "Kind of entity.",
              "examples": [
                "corporation",
                "sole proprietorship",
                "LLP",
                "not-for-profit corporation"
              ]
            },
            "signatory_name": {
              "type": "string",
              "description": "Person who instructs the firm on the organization's behalf.",
              "examples": [
                "Raj Patel, CFO"
              ]
            }
          }
        },
        "contact": {
          "type": "object",
          "description": "How to reach the client.",
          "properties": {
            "phones": {
              "type": "array",
              "description": "Phone numbers for the client.",
              "items": {
                "type": "string",
                "description": "A phone number, including any label such as mobile/home/work.",
                "examples": [
                  "(416) 555-0199",
                  "Cell: 647-555-0142",
                  "+1 613 555 0100 ext. 22"
                ]
              }
            },
            "emails": {
              "type": "array",
              "description": "Email addresses for the client.",
              "items": {
                "type": "string",
                "description": "An email address.",
                "examples": [
                  "jane.doe@example.com"
                ]
              }
            },
            "address": {
              "type": "object",
              "description": "Postal or street address of the client, split into parts where the document separates them.",
              "properties": {
                "street": {
                  "type": "string",
                  "description": "Street line(s): number, street name, unit/suite/apartment, RR or PO box.",
                  "examples": [
                    "1200 Bay St, Suite 300",
                    "Unit 4 - 22 King St W",
                    "RR 2"
                  ]
                },
                "city": {
                  "type": "string",
                  "description": "City, town or municipality.",
                  "examples": [
                    "Toronto",
                    "Mississauga",
                    "Thunder Bay"
                  ]
                },
                "province": {
                  "type": "string",
                  "description": "Province, territory or state.",
                  "examples": [
                    "ON",
                    "Ontario",
                    "QC"
                  ]
                },
                "postal_code": {
                  "type": "string",
                  "description": "Postal code (or US ZIP code).",
                  "examples": [
                    "M5R 2A5",
                    "K1A 0B1",
                    "L4W5K4"
                  ]
                },
                "country": {
                  "type": "string",
                  "description": "Country, written out or as a code.",
                  "examples": [
                    "Canada",
                    "CAN",
                    "USA"
                  ]
                },
                "full": {
                  "type": "string",
                  "description": "The whole address as a single line, when it is not split into parts.",
                  "examples": [
                    "22 King St W, Toronto ON M5H 1A1"
                  ],
                  "x-not-for": "Addresses already split into street/city/postal code on the page."
                }
              }
            },
            "preferred_method": {
              "type": "string",
              "description": "How they prefer to be contacted.",
              "examples": [
                "email",
                "text",
                "phone after 6 p.m."
              ]
            }
          }
        },
        "identification": {
          "type": "array",
          "description": "Identity documents the client produced for KYC checks.",
          "items": {
            "type": "object",
            "description": "One ID document.",
            "properties": {
              "document_type": {
                "type": "string",
                "description": "Kind of ID.",
                "examples": [
                  "Canadian passport",
                  "Ontario driver's licence",
                  "Ontario Photo Card",
                  "PR card",
                  "Status Card"
                ]
              },
              "number": {
                "type": "string",
                "description": "Document number.",
                "examples": [
                  "AB123456",
                  "D6101-40706-60905"
                ],
                "x-not-for": "Case, file, account or policy numbers."
              },
              "issuing_authority": {
                "type": "string",
                "description": "Issuing country or authority.",
                "examples": [
                  "Canada",
                  "Ontario",
                  "IRCC"
                ]
              },
              "issue_date": {
                "type": "string",
                "description": "Date issued.",
                "format": "date",
                "examples": [
                  "March 12, 2024",
                  "2024-03-12",
                  "12/03/2024"
                ]
              },
              "expiry_date": {
                "type": "string",
                "description": "Expiry date.",
                "format": "date",
                "examples": [
                  "March 12, 2024",
                  "2024-03-12",
                  "12/03/2024"
                ]
              }
            }
          }
        }
      },
      "x-not-for": "Other people or organizations involved in the matter (those go in parties)."
    },
    "matter": {
      "type": "object",
      "description": "What the client needs help with, as a whole.",
      "properties": {
        "type": {
          "type": "string",
          "description": "Area of law or kind of matter: civil litigation, personal injury, debt recovery, construction, corporate or commercial, real estate, landlord and tenant, family, wills and estates, employment, criminal, immigration, intellectual property, other.",
          "examples": [
            "wrongful dismissal",
            "residential purchase",
            "divorce",
            "LTB eviction"
          ]
        },
        "summary": {
          "type": "string",
          "description": "The client's account of the problem, or a summary of it.",
          "examples": [
            "My landlord kept my last month's rent deposit after I moved out."
          ],
          "x-not-for": "Individual dated incidents (those go in events)."
        },
        "objectives": {
          "type": "array",
          "description": "What the client wants to achieve.",
          "items": {
            "type": "string",
            "description": "One objective.",
            "examples": [
              "recover the deposit",
              "decision-making responsibility for both children"
            ]
          }
        },
        "jurisdiction": {
          "type": "string",
          "description": "Province or country whose law or courts apply.",
          "examples": [
            "Ontario",
            "federal",
            "Quebec"
          ]
        },
        "urgency": {
          "type": "string",
          "description": "Stated urgency or deadline pressure.",
          "examples": [
            "urgent",
            "hearing next week"
          ]
        },
        "key_deadlines": {
          "type": "array",
          "description": "Deadlines that matter to the case: limitation periods, filing or response deadlines, closing dates.",
          "items": {
            "type": "object",
            "description": "One deadline.",
            "properties": {
              "date": {
                "type": "string",
                "description": "The deadline date.",
                "format": "date",
                "examples": [
                  "March 12, 2024",
                  "2024-03-12",
                  "12/03/2024"
                ]
              },
              "description": {
                "type": "string",
                "description": "What must happen by then.",
                "examples": [
                  "statement of defence due",
                  "2-year limitation period expires",
                  "deadline to appeal"
                ]
              }
            }
          },
          "x-not-for": "Hearing dates (proceedings) and past events (events)."
        },
        "reference_numbers": {
          "type": "array",
          "description": "Reference numbers for this matter: the firm's own file number and references on correspondence.",
          "items": {
            "type": "string",
            "description": "One reference.",
            "examples": [
              "Our File No. 24-0117",
              "Your File: ABC-99"
            ]
          },
          "x-not-for": "Court case numbers (proceedings) and ID document numbers (client.identification)."
        }
      }
    },
    "parties": {
      "type": "array",
      "description": "Every person or organization involved other than the client: opposing parties, other sides' lawyers, witnesses, family members, employers, landlords, insurers, beneficiaries, co-defendants, experts. One item per party.",
      "items": {
        "type": "object",
        "description": "One party.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Person or organization name.",
            "examples": [
              "Acme Property Management Inc.",
              "John Smith"
            ]
          },
          "role": {
            "type": "string",
            "description": "Their role in the matter.",
            "examples": [
              "opposing party",
              "landlord",
              "witness",
              "spouse",
              "insurer",
              "opposing counsel",
              "estate trustee"
            ]
          },
          "relationship_to_client": {
            "type": "string",
            "description": "How they relate to the client.",
            "examples": [
              "ex-husband",
              "former employer",
              "neighbour"
            ]
          },
          "organization": {
            "type": "string",
            "description": "Organization they belong to or act for.",
            "examples": [
              "Smith & Co. LLP"
            ],
            "x-not-for": "The party's own name when the party is itself the organization."
          },
          "date_of_birth": {
            "type": "string",
            "description": "Their date of birth.",
            "format": "date",
            "examples": [
              "March 12, 2024",
              "2024-03-12",
              "12/03/2024"
            ]
          },
          "contact": {
            "type": "object",
            "description": "How to reach this party.",
            "properties": {
              "phones": {
                "type": "array",
                "description": "Phone numbers for this party.",
                "items": {
                  "type": "string",
                  "description": "A phone number, including any label such as mobile/home/work.",
                  "examples": [
                    "(416) 555-0199",
                    "Cell: 647-555-0142",
                    "+1 613 555 0100 ext. 22"
                  ]
                }
              },
              "emails": {
                "type": "array",
                "description": "Email addresses for this party.",
                "items": {
                  "type": "string",
                  "description": "An email address.",
                  "examples": [
                    "jane.doe@example.com"
                  ]
                }
              },
              "address": {
                "type": "object",
                "description": "Postal or street address of this party, split into parts where the document separates them.",
                "properties": {
                  "street": {
                    "type": "string",
                    "description": "Street line(s): number, street name, unit/suite/apartment, RR or PO box.",
                    "examples": [
                      "1200 Bay St, Suite 300",
                      "Unit 4 - 22 King St W",
                      "RR 2"
                    ]
                  },
                  "city": {
                    "type": "string",
                    "description": "City, town or municipality.",
                    "examples": [
                      "Toronto",
                      "Mississauga",
                      "Thunder Bay"
                    ]
                  },
                  "province": {
                    "type": "string",
                    "description": "Province, territory or state.",
                    "examples": [
                      "ON",
                      "Ontario",
                      "QC"
                    ]
                  },
                  "postal_code": {
                    "type": "string",
                    "description": "Postal code (or US ZIP code).",
                    "examples": [
                      "M5R 2A5",
                      "K1A 0B1",
                      "L4W5K4"
                    ]
                  },
                  "country": {
                    "type": "string",
                    "description": "Country, written out or as a code.",
                    "examples": [
                      "Canada",
                      "CAN",
                      "USA"
                    ]
                  },
                  "full": {
                    "type": "string",
                    "description": "The whole address as a single line, when it is not split into parts.",
                    "examples": [
                      "22 King St W, Toronto ON M5H 1A1"
                    ],
                    "x-not-for": "Addresses already split into street/city/postal code on the page."
                  }
                }
              },
              "preferred_method": {
                "type": "string",
                "description": "How they prefer to be contacted.",
                "examples": [
                  "email",
                  "text",
                  "phone after 6 p.m."
                ]
              }
            }
          },
          "represented_by": {
            "type": "string",
            "description": "Their lawyer, paralegal or law firm.",
            "examples": [
              "Harper Lee LLP (Ms. Chen)",
              "Legal Aid Ontario"
            ]
          }
        }
      },
      "x-not-for": "The client themself."
    },
    "events": {
      "type": "array",
      "description": "The chronology: dated things that happened (incidents, meetings, notices, payments, dismissals, accidents).",
      "items": {
        "type": "object",
        "description": "One event.",
        "properties": {
          "date": {
            "type": "string",
            "description": "When it happened.",
            "format": "date",
            "examples": [
              "March 12, 2024",
              "2024-03-12",
              "12/03/2024"
            ]
          },
          "time": {
            "type": "string",
            "description": "Time of day, if given.",
            "examples": [
              "around 3 p.m.",
              "14:30"
            ]
          },
          "description": {
            "type": "string",
            "description": "What happened.",
            "examples": [
              "slipped on an unmarked wet floor",
              "received termination letter",
              "served N4 notice"
            ]
          },
          "location": {
            "type": "string",
            "description": "Where it happened.",
            "examples": [
              "Loblaws, Queen St W",
              "Highway 401 eastbound near Keele"
            ]
          }
        }
      },
      "x-not-for": "Future deadlines (matter.key_deadlines) and hearing dates (proceedings)."
    },
    "amounts": {
      "type": "array",
      "description": "Money figures that no more specific field covers: sums claimed, debts, damages, fees, invoices, settlement offers.",
      "items": {
        "type": "object",
        "description": "One amount.",
        "properties": {
          "amount": {
            "type": "string",
            "description": "The figure as written, with currency symbol or code.",
            "examples": [
              "$1,200.00",
              "CAD 45,000",
              "$3 500,00"
            ]
          },
          "currency": {
            "type": "string",
            "description": "Currency, if stated separately.",
            "examples": [
              "CAD",
              "USD"
            ]
          },
          "description": {
            "type": "string",
            "description": "What the money is.",
            "examples": [
              "unpaid invoice #402",
              "rent arrears",
              "Rule 49 offer to settle"
            ]
          },
          "date": {
            "type": "string",
            "description": "Date the amount relates to.",
            "format": "date",
            "examples": [
              "March 12, 2024",
              "2024-03-12",
              "12/03/2024"
            ]
          }
        }
      },
      "x-not-for": "Salary (employment), property price (property), estate value (estate)."
    },
    "proceedings": {
      "type": "array",
      "description": "Court, tribunal or regulator cases, existing or threatened.",
      "items": {
        "type": "object",
        "description": "One proceeding.",
        "properties": {
          "forum": {
            "type": "string",
            "description": "Court, tribunal or body.",
            "examples": [
              "Ontario Superior Court of Justice",
              "Small Claims Court (Toronto)",
              "Landlord and Tenant Board",
              "Human Rights Tribunal of Ontario",
              "Ontario Court of Justice",
              "Court of Appeal for Ontario"
            ]
          },
          "case_number": {
            "type": "string",
            "description": "Court or tribunal file number.",
            "examples": [
              "CV-24-00712345-0000",
              "SC-24-00001234-0000",
              "LTB-L-012345-24",
              "FS-24-1234",
              "2024-12345-I"
            ],
            "x-not-for": "The firm's own file references (matter.reference_numbers)."
          },
          "stage": {
            "type": "string",
            "description": "Where the case stands.",
            "examples": [
              "statement of claim issued",
              "discoveries",
              "pre-trial conference",
              "appeal"
            ]
          },
          "filing_date": {
            "type": "string",
            "description": "Date the case was filed.",
            "format": "date",
            "examples": [
              "March 12, 2024",
              "2024-03-12",
              "12/03/2024"
            ]
          },
          "next_hearing_date": {
            "type": "string",
            "description": "Next hearing or court date.",
            "format": "date",
            "examples": [
              "March 12, 2024",
              "2024-03-12",
              "12/03/2024"
            ]
          },
          "judge": {
            "type": "string",
            "description": "Judge, adjudicator or officer.",
            "examples": [
              "Justice Morgan",
              "Deputy Judge Patel",
              "Member Leung"
            ]
          },
          "orders": {
            "type": "array",
            "description": "Orders or judgments made.",
            "items": {
              "type": "string",
              "description": "One order.",
              "examples": [
                "interim injunction granted May 3",
                "temporary order for parenting time"
              ]
            }
          }
        }
      }
    },
    "referenced_documents": {
      "type": "array",
      "description": "Documents mentioned in, or making up, the scans: contracts, leases, letters, notices, wills, invoices, ROEs, reports.",
      "items": {
        "type": "object",
        "description": "One document.",
        "properties": {
          "title": {
            "type": "string",
            "description": "Document title or kind.",
            "examples": [
              "Residential Tenancy Agreement (Standard Form of Lease)",
              "Form N4",
              "Record of Employment",
              "Agreement of Purchase and Sale"
            ]
          },
          "date": {
            "type": "string",
            "description": "Document date.",
            "format": "date",
            "examples": [
              "March 12, 2024",
              "2024-03-12",
              "12/03/2024"
            ]
          },
          "author": {
            "type": "string",
            "description": "Who wrote, sent or issued it.",
            "examples": [
              "HR Department, Acme Ltd."
            ]
          },
          "recipient": {
            "type": "string",
            "description": "Who it was addressed to.",
            "examples": [
              "Ms. J. Doe"
            ]
          },
          "reference": {
            "type": "string",
            "description": "Its reference or invoice number.",
            "examples": [
              "INV-0042"
            ]
          }
        }
      }
    },
    "property": {
      "type": "object",
      "description": "Real estate at the heart of the matter: purchase, sale, lease, mortgage or dispute.",
      "properties": {
        "address": {
          "type": "object",
          "description": "Postal or street address of the property, split into parts where the document separates them.",
          "properties": {
            "street": {
              "type": "string",
              "description": "Street line(s): number, street name, unit/suite/apartment, RR or PO box.",
              "examples": [
                "1200 Bay St, Suite 300",
                "Unit 4 - 22 King St W",
                "RR 2"
              ]
            },
            "city": {
              "type": "string",
              "description": "City, town or municipality.",
              "examples": [
                "Toronto",
                "Mississauga",
                "Thunder Bay"
              ]
            },
            "province": {
              "type": "string",
              "description": "Province, territory or state.",
              "examples": [
                "ON",
                "Ontario",
                "QC"
              ]
            },
            "postal_code": {
              "type": "string",
              "description": "Postal code (or US ZIP code).",
              "examples": [
                "M5R 2A5",
                "K1A 0B1",
                "L4W5K4"
              ]
            },
            "country": {
              "type": "string",
              "description": "Country, written out or as a code.",
              "examples": [
                "Canada",
                "CAN",
                "USA"
              ]
            },
            "full": {
              "type": "string",
              "description": "The whole address as a single line, when it is not split into parts.",
              "examples": [
                "22 King St W, Toronto ON M5H 1A1"
              ],
              "x-not-for": "Addresses already split into street/city/postal code on the page."
            }
          }
        },
        "legal_description": {
          "type": "string",
          "description": "Land registry identifiers: PIN, lot and plan, LRO.",
          "examples": [
            "PIN 21401-0123 (LT)",
            "Lot 12, Plan 66M-2345",
            "LRO #80"
          ]
        },
        "property_type": {
          "type": "string",
          "description": "Kind of property.",
          "examples": [
            "detached house",
            "condominium unit",
            "retail unit"
          ]
        },
        "transaction_type": {
          "type": "string",
          "description": "Purchase, sale, lease, refinance...",
          "examples": [
            "purchase",
            "sale",
            "commercial lease",
            "refinance"
          ]
        },
        "price": {
          "type": "string",
          "description": "Purchase or sale price, or rent.",
          "examples": [
            "$850,000",
            "$2,450/month"
          ]
        },
        "deposit": {
          "type": "string",
          "description": "Deposit paid or held.",
          "examples": [
            "$1,200.00",
            "CAD 45,000",
            "$3 500,00"
          ]
        },
        "closing_date": {
          "type": "string",
          "description": "Closing or possession date.",
          "format": "date",
          "examples": [
            "March 12, 2024",
            "2024-03-12",
            "12/03/2024"
          ]
