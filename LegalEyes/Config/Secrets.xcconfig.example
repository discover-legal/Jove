// Copy to Secrets.xcconfig (git-ignored) and fill in.
// DEVELOPMENT_TEAM: Apple Developer Team ID (10 chars).
// META_APP_ID / CLIENT_TOKEN: from the project's Configuration tab in the
// Wearables Developer Center, after adding the iOS bundle ID.
DEVELOPMENT_TEAM = ABCDE12345
META_APP_ID = 1234567890123456
CLIENT_TOKEN = 0123456789abcdef0123456789abcdef
